if(BUILD_TESTING)
    function(vellum_test_executable name)
        add_executable(${name} ${ARGN})
        vellum_target(${name})
    endfunction()
    if(VELLUM_COVERAGE)
        add_test(NAME testing.ram_coverage COMMAND ${Python3_EXECUTABLE}
            ${PROJECT_SOURCE_DIR}/tests/test_coverage_in_ram.py)
        set_tests_properties(testing.ram_coverage PROPERTIES TIMEOUT 180 PROCESSORS 2)
    endif()
    vellum_test_executable(vellum_layout_tests tests/test_layout.cc)
    target_link_libraries(vellum_layout_tests PRIVATE vellum_print_plan vellum_view_geometry)
    add_test(NAME viewer.zoom_sheet_layout COMMAND vellum_layout_tests)
    vellum_test_executable(vellum_print_plan_tests tests/test_print_plan.cc)
    target_link_libraries(vellum_print_plan_tests PRIVATE vellum_print_plan)
    add_test(NAME printing.portable_page_selection COMMAND vellum_print_plan_tests)
    vellum_test_executable(vellum_print_allocation_fault_tests tests/test_print_allocation_faults.cc)
    target_link_libraries(vellum_print_allocation_fault_tests PRIVATE vellum_print_plan)
    add_test(NAME printing.allocation_failures COMMAND vellum_print_allocation_fault_tests)
    vellum_test_executable(vellum_core_tests tests/test_core.cc)
    target_link_libraries(vellum_core_tests PRIVATE vellum_recovery)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_definitions(vellum_core_tests PRIVATE VELLUM_STATE_EXCEPTION_FAULTS)
        target_link_options(vellum_core_tests PRIVATE
            "-Wl,--wrap=_ZNSt14overflow_errorC1EPKc,--wrap=_ZNSt11logic_errorC1EPKc")
    endif()
    add_test(NAME core.autosave_recovery COMMAND vellum_core_tests)
    vellum_test_executable(vellum_disk_full_tests tests/test_disk_full.cc)
    target_link_libraries(vellum_disk_full_tests PRIVATE vellum_recovery)
    add_test(NAME core.disk_full COMMAND ${Python3_EXECUTABLE}
        ${PROJECT_SOURCE_DIR}/scripts/run_disk_full_test.py $<TARGET_FILE:vellum_disk_full_tests>)
    set_tests_properties(core.disk_full PROPERTIES TIMEOUT 120)
    add_test(NAME core.disk_full_guard COMMAND ${Python3_EXECUTABLE}
        ${PROJECT_SOURCE_DIR}/tests/test_disk_full_guard.py $<TARGET_FILE:vellum_disk_full_tests>
        ${PROJECT_SOURCE_DIR}/scripts/run_disk_full_test.py)
    add_test(NAME core.disk_full_runner COMMAND ${Python3_EXECUTABLE}
        ${PROJECT_SOURCE_DIR}/tests/test_disk_full_runner.py)
    vellum_test_executable(vellum_atomic_allocation_fault_tests tests/test_atomic_allocation_faults.cc)
    target_link_libraries(vellum_atomic_allocation_fault_tests PRIVATE vellum_persistence)
    add_test(NAME core.atomic_allocation_failures COMMAND vellum_atomic_allocation_fault_tests)
    set_tests_properties(core.atomic_allocation_failures PROPERTIES RESOURCE_LOCK vellum_disk_io TIMEOUT 120)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        vellum_test_executable(vellum_atomic_fault_tests tests/test_atomic_faults.cc)
        target_link_libraries(vellum_atomic_fault_tests PRIVATE vellum_recovery)
        target_link_options(vellum_atomic_fault_tests PRIVATE
            "-Wl,--wrap=write,--wrap=fsync,--wrap=rename,--wrap=mkostemp,--wrap=mkostemp64")
        add_test(NAME core.atomic_faults COMMAND vellum_atomic_fault_tests)
        set_tests_properties(core.atomic_faults PROPERTIES RESOURCE_LOCK vellum_disk_io TIMEOUT 120)
    endif()
    set_tests_properties(core.autosave_recovery core.disk_full PROPERTIES RESOURCE_LOCK vellum_disk_io)
    vellum_test_executable(vellum_fake_worker tests/fake_worker.cc)
    if(VELLUM_COVERAGE AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        # Test-only workers can be killed while exiting; their counters are not
        # included in production coverage and must not corrupt parallel runs.
        target_compile_options(vellum_fake_worker PRIVATE -fno-profile-arcs -fno-test-coverage)
    endif()
    target_link_libraries(vellum_fake_worker PRIVATE vellum_scripting_transport)
    vellum_test_executable(vellum_ipc_tests tests/test_ipc.cc)
    target_link_libraries(vellum_ipc_tests PRIVATE vellum_scripting_transport)
    add_test(NAME ipc.process_shared_memory COMMAND vellum_ipc_tests $<TARGET_FILE:vellum_fake_worker>)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
        vellum_test_executable(vellum_ipc_fault_tests tests/test_ipc_faults.cc)
        target_link_libraries(vellum_ipc_fault_tests PRIVATE vellum_scripting_transport)
        target_link_options(vellum_ipc_fault_tests PRIVATE
            "-Wl,--wrap=socketpair,--wrap=memfd_create,--wrap=ftruncate,--wrap=ftruncate64,--wrap=mmap,--wrap=mmap64,--wrap=posix_spawn,--wrap=posix_spawn_file_actions_init,--wrap=posix_spawn_file_actions_destroy,--wrap=posix_spawn_file_actions_adddup2,--wrap=send,--wrap=poll,--wrap=recv,--wrap=waitpid,--wrap=_ZNSt13runtime_errorC1EPKc")
        add_test(NAME ipc.system_faults COMMAND vellum_ipc_fault_tests $<TARGET_FILE:vellum_fake_worker>)
        set_tests_properties(ipc.system_faults PROPERTIES TIMEOUT 30)
        vellum_test_executable(vellum_ipc_fcntl_fault_tests tests/test_ipc_fcntl_faults.cc)
        target_link_libraries(vellum_ipc_fcntl_fault_tests PRIVATE vellum_scripting_transport)
        target_link_options(vellum_ipc_fcntl_fault_tests PRIVATE "-Wl,--wrap=fcntl,--wrap=fcntl64")
        add_test(NAME ipc.descriptor_faults COMMAND vellum_ipc_fcntl_fault_tests $<TARGET_FILE:vellum_fake_worker>)
        set_tests_properties(ipc.descriptor_faults PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77)
    endif()
    add_test(NAME catalogs.immutable COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/scripts/check_catalogs.py)
    add_test(NAME builder.unit COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/tests/test_builder.py)
    add_test(NAME builder.repair COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/tests/test_dependency_repair.py)
    set_tests_properties(core.autosave_recovery PROPERTIES TIMEOUT 120)
    set_tests_properties(ipc.process_shared_memory PROPERTIES TIMEOUT 20)
endif()
